<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>LunaOptimizer.ico</ApplicationIcon>
    <!-- FluentCleaner.Core esta vendrado DENTRO de este proyecto: excluyelo de los
         globs por defecto o sus .cs y su obj/ se compilan dos veces (CS0579). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);FluentCleaner.Core\**</DefaultItemExcludes>
    <AssemblyTitle>LunaOptimizer</AssemblyTitle>
    <Product>LunaOptimizer</Product>
    <Version>1.1.0</Version>
    <Description>Optimizador de PC</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Winapp2.ini viaja dentro del exe: sin el, la pestaña Limpieza sale vacia en otro PC -->
  <ItemGroup>
    <EmbeddedResource Include="Winapp2.ini" LogicalName="LunaOptimizer.Winapp2.ini" />
    <Resource Include="LunaOptimizer.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FluentCleaner.Core\FluentCleaner.Core.csproj" />
  </ItemGroup>

</Project>
