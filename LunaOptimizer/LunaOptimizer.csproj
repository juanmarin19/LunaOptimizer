<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>LunaOptimizer.ico</ApplicationIcon>
    <AssemblyTitle>LunaOptimizer</AssemblyTitle>
    <Product>LunaOptimizer</Product>
    <Version>4.0.0</Version>
    <Description>Optimizador de PC</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Winapp2.ini viaja dentro del exe: sin el, la pestaña Limpieza sale vacia en otro PC -->
  <ItemGroup>
    <EmbeddedResource Include="..\FluentCleaner\Winapp2.ini" LogicalName="LunaOptimizer.Winapp2.ini" />
    <Resource Include="LunaOptimizer.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentCleaner\FluentCleaner.Core\FluentCleaner.Core.csproj" />
  </ItemGroup>

</Project>
