<UserControl x:Class="LunaOptimizer.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="Transparent">

        <Grid Margin="2,2,0,0">
            <TextBlock Text="Aplicaciones" Style="{StaticResource H1}"/>
            <TextBlock x:Name="TxtCount" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </Grid>
        <TextBlock Text="Programas instalados en este equipo. Se desinstalan con su propio desinstalador."
                   Style="{StaticResource Body}" Margin="2,3,0,10"/>

        <Border Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <TextBox x:Name="TxtFilter" ToolTip="Filtrar por nombre o fabricante"
                         TextChanged="TxtFilter_TextChanged"/>
                <TextBlock x:Name="TxtFilterHint" Text="Buscar aplicacion" FontSize="12"
                           Foreground="{DynamicResource B_Muted}" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource B_Card}" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource B_CardBorder}" Padding="8,6,4,6" Margin="0,0,0,8">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" MaxHeight="380"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="4,4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource B_Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource B_Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource B_Muted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                        <Run Text="{Binding Publisher, Mode=OneWay}"/><Run Text=" · "/><Run
                                            Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run
                                            Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Desinstalar" Tag="{Binding}"
                                        Click="BtnUninstall_Click" Style="{StaticResource LinkBtn}"
                                        Foreground="{DynamicResource B_Red}" FontSize="11"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TxtEmpty" Text="Cargando aplicaciones instaladas..." FontSize="11.5"
                           Foreground="{DynamicResource B_Sub}" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
