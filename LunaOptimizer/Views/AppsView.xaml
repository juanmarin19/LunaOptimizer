<UserControl x:Class="LunaOptimizer.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra: buscar + refrescar + conteo -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtFilter" Width="150" ToolTip="Filtrar por nombre o publicador" TextChanged="TxtFilter_TextChanged"/>
                <Button x:Name="BtnRefresh" Content="Actualizar" Click="BtnRefresh_Click"
                        Style="{StaticResource {x:Type Button}}" Padding="9,5" FontSize="12" Margin="6,0,0,0"/>
                <TextBlock x:Name="TxtCount" Text="" Foreground="{DynamicResource B_Sub}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Lista de apps -->
        <Border Grid.Row="1" Background="{DynamicResource B_Bg}" CornerRadius="10"
                BorderBrush="{DynamicResource B_BorderSoft}" BorderThickness="1" Margin="0,4,0,0">
            <Grid>
                <ListView x:Name="List" Background="Transparent" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B_Text}"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource B_Sub}">
                                            <Run Text="{Binding Publisher, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Desinstalar" Tag="{Binding}" Click="BtnUninstall_Click"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource {x:Type Button}}" Padding="10,4" FontSize="11"
                                            Background="{DynamicResource B_Red}" Foreground="{DynamicResource B_OnRed}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="TxtEmpty" Text="Cargando apps instaladas..." FontSize="12"
                           Foreground="{DynamicResource B_Sub}" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Estado / progreso -->
        <Border Grid.Row="2" Background="{DynamicResource B_Rail}" Padding="10,6" Margin="0,6,0,0" CornerRadius="8">
            <TextBlock x:Name="TxtStatus" Text="Listo." FontSize="11" Foreground="{DynamicResource B_Sub}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
