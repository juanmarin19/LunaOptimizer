<UserControl x:Class="LunaOptimizer.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="Transparent">

        <Grid Margin="2,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource LinkBtn}" Click="BtnBack_Click"
                    VerticalAlignment="Center" ToolTip="Volver">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource I.ChevronLeft}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource B_Link}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Volver" FontSize="12" Margin="4,0,0,0" Foreground="{DynamicResource B_Link}"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Rendimiento" Style="{StaticResource H1}" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="Servicios y ajustes de Windows que afectan al rendimiento y a los juegos."
                   Style="{StaticResource Body}" Margin="2,4,0,10"/>

        <Border Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Ajustes del sistema" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource B_Text}"/>
                    <TextBlock x:Name="TxtScore" FontSize="10.5" Foreground="{DynamicResource B_Sub}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Optimizar todo" Click="BtnOptimizeAll_Click"
                        Style="{StaticResource PrimaryBtn}" Height="32" Padding="12,0" FontSize="12"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource B_Card}" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource B_CardBorder}" Padding="6,4,4,4" Margin="0,0,0,8">
            <Grid>
                <ListView x:Name="List" Background="Transparent" BorderThickness="0" MaxHeight="392"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,1"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                                Padding="4,5">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource B_Red}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource B_Green}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Nombre}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource B_Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Descripcion}" FontSize="10"
                                               Foreground="{DynamicResource B_Muted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding Estado}" FontSize="10"
                                               Foreground="{DynamicResource B_Sub}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="{Binding Accion}" Tag="{Binding}"
                                        Click="BtnToggle_Click" VerticalAlignment="Center"
                                        Style="{StaticResource LinkBtn}" FontSize="11"
                                        Foreground="{DynamicResource B_Link}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="TxtEmpty" Text="Analizando el sistema..." FontSize="11.5"
                           Foreground="{DynamicResource B_Sub}" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
