<UserControl x:Class="LunaOptimizer.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Salud del sistema" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource B_Text}"/>
                    <TextBlock x:Name="TxtScore" FontSize="12" Foreground="{DynamicResource B_Sub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Optimizar todo" Click="BtnOptimizeAll_Click"
                        Style="{StaticResource PrimaryBtn}" Padding="12,6" FontSize="12"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource B_Bg}" CornerRadius="10"
                BorderBrush="{DynamicResource B_BorderSoft}" BorderThickness="1">
            <Grid>
                <ListView x:Name="List" Background="Transparent" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- indicador verde/rojo -->
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource B_Red}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource B_Green}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B_Text}"/>
                                        <TextBlock Text="{Binding Descripcion}" FontSize="10" Foreground="{DynamicResource B_Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Estado}" FontSize="10" Foreground="{DynamicResource B_Sub}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="{Binding Accion}" Tag="{Binding}"
                                            Click="BtnToggle_Click" VerticalAlignment="Center"
                                            Style="{StaticResource {x:Type Button}}" Padding="10,4" FontSize="11"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="TxtEmpty" Text="Analizando el sistema..." FontSize="12"
                           Foreground="{DynamicResource B_Sub}" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
