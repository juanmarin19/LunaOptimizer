<UserControl x:Class="LunaOptimizer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="Transparent">

        <TextBlock Text="Ajustes" Style="{StaticResource H1}" Margin="2,2,0,0"/>
        <TextBlock Text="Todo se guarda en tu equipo. Sin cuentas, sin telemetría." Style="{StaticResource Body}"
                   Margin="2,3,0,10"/>

        <!-- ===== Apariencia ===== -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Tema oscuro" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource B_Text}"/>
                    <TextBlock Text="Tambien puedes cambiarlo con el boton de la barra de titulo."
                               Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="ChkOscuro" Style="{StaticResource Switch}"
                          VerticalAlignment="Center" Click="ChkOscuro_Click"/>
            </Grid>
        </Border>

        <!-- ===== Smart Boost ===== -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Smart Boost" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B_Text}"/>
                        <TextBlock Text="Libera memoria y temporales solo cuando el PC se pone lento."
                                   Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkSmart" Style="{StaticResource Switch}"
                              VerticalAlignment="Center" Click="ChkSmart_Click"/>
                </Grid>

                <StackPanel x:Name="PanelUmbrales" Margin="0,12,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Activar cuando la RAM pase de" FontSize="11.5"
                                   Foreground="{DynamicResource B_Sub}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="−" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Padding="0" FontSize="14" Click="RamMenos_Click"/>
                            <TextBlock x:Name="TxtRamUmbral" Text="90%" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                       MinWidth="42" TextAlignment="Center"/>
                            <Button Content="+" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Padding="0" FontSize="14" Click="RamMas_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="O cuando los temporales pasen de" FontSize="11.5"
                                   Foreground="{DynamicResource B_Sub}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="−" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Padding="0" FontSize="14" Click="TempMenos_Click"/>
                            <TextBlock x:Name="TxtTempUmbral" Text="1024 MB" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                       MinWidth="62" TextAlignment="Center"/>
                            <Button Content="+" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Padding="0" FontSize="14" Click="TempMas_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Inicio ===== -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Iniciar con Windows" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource B_Text}"/>
                    <TextBlock Text="Abre LunaOptimizer al encender el equipo (para Smart Boost)."
                               Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="ChkInicio" Style="{StaticResource Switch}"
                          VerticalAlignment="Center" Click="ChkInicio_Click"/>
            </Grid>
        </Border>

        <!-- ===== Datos ===== -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Datos y soporte" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Abrir carpeta de datos" Style="{StaticResource SecondaryBtn}"
                            Click="BtnAbrirDatos_Click" Margin="0,0,8,0"/>
                    <Button Content="Ver registro de errores" Style="{StaticResource SecondaryBtn}"
                            Click="BtnLog_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtDatos" Text="" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===== Acerca de ===== -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="LunaOptimizer" Style="{StaticResource H2}"/>
                <TextBlock x:Name="TxtVersion" Text="" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                <TextBlock Text="Optimizador para Windows 10/11 con interfaz estilo Microsoft PC Manager. Licencia MIT."
                           Style="{StaticResource Body}" Margin="0,6,0,0"/>
                <Button Content="Ver el proyecto en GitHub" Style="{StaticResource LinkBtn}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="BtnRepo_Click"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
