<UserControl x:Class="LunaOptimizer.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CompactBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtFilter" Width="104" ToolTip="Filtrar por nombre" TextChanged="TxtFilter_TextChanged"/>
                <Button x:Name="BtnRefresh" Content="Actualizar" Style="{StaticResource CompactBtn}" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnLocation" Content="Ubicacion" Style="{StaticResource CompactBtn}" Click="BtnLocation_Click"/>
                <CheckBox x:Name="ChkGroup" Content="Agrupar" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="True" Checked="ChkGroup_Changed" Unchecked="ChkGroup_Changed" ToolTip="Una fila por programa (brave x8)"/>
                <CheckBox x:Name="ChkAuto" Content="Auto 2s" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Checked="ChkAuto_Checked" Unchecked="ChkAuto_Unchecked"/>
                <CheckBox x:Name="ChkTodos" Content="Ver todos" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Checked="ChkTodos_Changed" Unchecked="ChkTodos_Changed" ToolTip="Mostrar tambien procesos del sistema y de fondo"/>
                <TextBlock x:Name="TxtCount" Text="" Foreground="#B9B9B9" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="10" BorderBrush="#2D2D2D" BorderThickness="1">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" Foreground="White"
                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" FontSize="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ColIcon" Header="" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColName" Header="Programa" Binding="{Binding Display}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="6,4,4,4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColPids" Header="PIDs" Binding="{Binding Pids}" Width="56">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B9B9B9"/>
                                <Setter Property="Padding" Value="4,4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColRam" Header="RAM MB" Binding="{Binding TotalRamMB}" Width="62">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#6CCB7F"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="4,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Finalizar" Click="BtnKillRow_Click"
                                        Style="{StaticResource CompactBtn}"
                                        Background="#FF7B7B" Foreground="#0B1B24"
                                        FontWeight="SemiBold" Padding="7,3" FontSize="11"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ToolTip="Terminar este programa"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
