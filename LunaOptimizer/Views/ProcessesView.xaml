<UserControl x:Class="LunaOptimizer.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Background="Transparent">
        <Grid Margin="2,2,0,0">
            <TextBlock Text="Procesos" Style="{StaticResource H1}"/>
            <TextBlock x:Name="TxtCount" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </Grid>
        <TextBlock Text="Solo aplicaciones que es seguro cerrar. Nunca procesos del sistema."
                   Style="{StaticResource Body}" Margin="2,3,0,10"/>

        <Border Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
                <Grid>
                    <TextBox x:Name="TxtFilter" ToolTip="Filtrar por nombre" TextChanged="TxtFilter_TextChanged"/>
                    <TextBlock x:Name="TxtFilterHint" Text="Buscar aplicacion" FontSize="12"
                               Foreground="{DynamicResource B_Muted}" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnRefresh" Content="Actualizar" Style="{StaticResource MiniBtn}"
                            Margin="0,0,6,0" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnLocation" Content="Ubicacion" Style="{StaticResource MiniBtn}"
                            Margin="0,0,10,0" Click="BtnLocation_Click"/>
                    <CheckBox x:Name="ChkGroup" Content="Agrupar" IsChecked="True" Margin="0,0,10,0"
                              VerticalAlignment="Center" Checked="ChkGroup_Changed" Unchecked="ChkGroup_Changed"
                              ToolTip="Una fila por programa"/>
                    <CheckBox x:Name="ChkAuto" Content="Auto" Margin="0,0,10,0" VerticalAlignment="Center"
                              Checked="ChkAuto_Checked" Unchecked="ChkAuto_Unchecked"/>
                    <CheckBox x:Name="ChkTodos" Content="Ver todos" VerticalAlignment="Center"
                              Checked="ChkTodos_Changed" Unchecked="ChkTodos_Changed"
                              ToolTip="Incluye procesos del sistema y de fondo"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource B_Card}" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource B_CardBorder}" Margin="0,0,0,8" Padding="2">
            <Grid>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" Height="392"
                          Background="Transparent" Foreground="{DynamicResource B_Text}"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" FontSize="11.5"
                          RowHeight="30" ColumnHeaderHeight="26" CanUserResizeColumns="False"
                          CanUserResizeRows="False" CanUserAddRows="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="ColIcon" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="17" Height="17" Stretch="Uniform"
                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColName" Header="Programa" Binding="{Binding Display}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Margin" Value="2,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColPids" Header="PIDs" Binding="{Binding Pids}" Width="64">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource B_Muted}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColRam" Header="RAM MB" Binding="{Binding TotalRamMB}" Width="58">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource B_Sub}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Cerrar" Tag="{Binding}" Click="BtnKillRow_Click"
                                            Style="{StaticResource LinkBtn}"
                                            Foreground="{DynamicResource B_Red}" FontSize="11"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanKill}"
                                            ToolTip="Cerrar este programa"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtEmpty" Text="No hay procesos que mostrar." FontSize="11.5"
                           Foreground="{DynamicResource B_Sub}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
