<UserControl x:Class="LunaOptimizer.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Acciones -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
            <Button x:Name="BtnDeep" Content="Limpieza profunda" Style="{StaticResource PrimaryBtn}"
                    Padding="14,8" FontSize="12" Margin="0" HorizontalAlignment="Stretch" Click="BtnDeep_Click"/>
        </Border>

        <!-- Lista de aplicaciones detectadas -->
        <Border Grid.Row="1" Background="{DynamicResource B_Bg}" CornerRadius="10"
                BorderBrush="{DynamicResource B_BorderSoft}" BorderThickness="1">
            <Grid>
                <ListView x:Name="List" SelectionMode="Extended" Background="Transparent"
                          Foreground="{DynamicResource B_Text}"
                          BorderThickness="0" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="App" Width="218">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource B_Text}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Tamano" DisplayMemberBinding="{Binding Size}" Width="90"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Estado vacio -->
                <TextBlock x:Name="TxtEmpty" Text="Buscando aplicaciones instaladas..." FontSize="12"
                           Foreground="{DynamicResource B_Sub}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="TxtStatus" Text="..." Foreground="{DynamicResource B_Sub}"
                   FontSize="12" Margin="2,8,0,0"/>
    </Grid>
</UserControl>
