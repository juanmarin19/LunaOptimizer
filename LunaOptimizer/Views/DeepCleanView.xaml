<UserControl x:Class="LunaOptimizer.Views.DeepCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="Transparent">

        <!-- Cabecera -->
        <Grid Margin="2,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnBack" Style="{StaticResource LinkBtn}" Click="BtnBack_Click"
                    VerticalAlignment="Center" ToolTip="Volver">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource I.ChevronLeft}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource B_Link}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Volver" FontSize="12" Margin="4,0,0,0" Foreground="{DynamicResource B_Link}"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Limpieza profunda" Style="{StaticResource H1}" Margin="10,0,0,0"/>
        </Grid>

        <!-- Estado del analisis / limpieza -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource B_Chip}" VerticalAlignment="Top">
                        <Path Data="{StaticResource I.Trash}" Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource B_Accent}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <TextBlock x:Name="TxtHead" Text="Preparando el analisis..."
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B_Text}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtHeadSub" Text="" FontSize="11"
                                   Foreground="{DynamicResource B_Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="BarScan" Height="4" Margin="0,9,0,0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="BtnAction" Content="Cancelar" Click="BtnAction_Click" Margin="0,12,0,0"
                        HorizontalAlignment="Stretch" Style="{StaticResource SecondaryBtn}"/>
            </StackPanel>
        </Border>

        <!-- Aviso: que se respeta siempre -->
        <Border Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource I.Shield}" Width="14" Height="14" Stretch="Uniform"
                      VerticalAlignment="Top" Margin="0,1,8,0"
                      Stroke="{DynamicResource B_Green}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource B_Sub}" TextWrapping="Wrap"
                           Text="Los datos de los navegadores (historial, contraseñas, cookies, sesiones y marcadores) están protegidos: de Chrome, Edge, Firefox, Brave, Opera y Vivaldi solo se borra la caché."/>
            </Grid>
        </Border>

        <!-- Durante el analisis: las cinco categorias con su estado -->
        <Border x:Name="PanelProgreso" Style="{StaticResource Card}" Padding="14,6">
            <StackPanel>
                <Border BorderBrush="{DynamicResource B_BorderSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Elementos recomendados" FontSize="12" Foreground="{DynamicResource B_TextSoft}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="St0" Text="Esperando a examinar..." FontSize="10.5"
                                   Foreground="{DynamicResource B_Sub}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource B_BorderSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Otros elementos del sistema" FontSize="12" Foreground="{DynamicResource B_TextSoft}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="St1" Text="Esperando a examinar..." FontSize="10.5"
                                   Foreground="{DynamicResource B_Sub}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource B_BorderSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Otros elementos de la aplicación" FontSize="12" Foreground="{DynamicResource B_TextSoft}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="St2" Text="Esperando a examinar..." FontSize="10.5"
                                   Foreground="{DynamicResource B_Sub}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource B_BorderSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Seguimientos de uso del equipo" FontSize="12" Foreground="{DynamicResource B_TextSoft}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="St3" Text="Esperando a examinar..." FontSize="10.5"
                                   Foreground="{DynamicResource B_Sub}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <Border Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Papelera de reciclaje" FontSize="12" Foreground="{DynamicResource B_TextSoft}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="St4" Text="Esperando a examinar..." FontSize="10.5"
                                   Foreground="{DynamicResource B_Sub}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tras el analisis: detalle de lo que se va a borrar -->
        <StackPanel x:Name="PanelResultados" Visibility="Collapsed"/>

        <TextBlock x:Name="TxtStatus" Text="" FontSize="10.5" Foreground="{DynamicResource B_Muted}"
                   Margin="2,4,0,8" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
