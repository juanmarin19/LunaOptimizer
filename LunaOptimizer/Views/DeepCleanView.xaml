<UserControl x:Class="LunaOptimizer.Views.DeepCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="Transparent">

        <!-- Cabecera -->
        <Grid Margin="2,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnBack" Style="{StaticResource LinkBtn}" Click="BtnBack_Click"
                    VerticalAlignment="Center" ToolTip="Volver">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource I.ChevronLeft}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource B_Link}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Volver" FontSize="12" Margin="4,0,0,0" Foreground="{DynamicResource B_Link}"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Limpieza profunda" Style="{StaticResource H1}" Margin="10,0,0,0"/>
        </Grid>

        <!-- Resumen + accion, como PC Manager -->
        <Border Style="{StaticResource Card}" Padding="12,12,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#63B3F2" Offset="0"/>
                            <GradientStop Color="#2B7BD0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="{StaticResource I.Trash}" Width="24" Height="24" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="White" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHead" Text="Analizando el equipo..." FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource B_Text}" TextWrapping="Wrap" LineHeight="19"/>
                    <TextBlock x:Name="TxtSel" Text="" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource B_Link}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BarScan" Height="3" Margin="0,8,0,0" Maximum="100" Value="0"
                                 Visibility="Collapsed"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnAction" Content="Continuar" Style="{StaticResource CtaBtn}"
                        VerticalAlignment="Center" Click="BtnAction_Click"/>
            </Grid>
        </Border>

        <!-- Arbol de elementos a borrar -->
        <Border Style="{StaticResource Card}" Padding="10,4,8,6">
            <StackPanel x:Name="PanelArbol"/>
        </Border>

        <TextBlock x:Name="TxtStatus" Text="" FontSize="10.5" Foreground="{DynamicResource B_Muted}"
                   Margin="2,2,0,8" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
