<UserControl x:Class="LunaOptimizer.Views.BoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="#1E1E2E" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="4,10,4,4">
        <Border Background="#2A2B3D" CornerRadius="12" Padding="14" Margin="0,0,0,12">
        <StackPanel>
        <TextBlock Text="Boost de memoria" FontSize="17" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Vacia working sets + GC. Seguro, no cierra apps." Foreground="#D0D4E8" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
        <Button x:Name="BtnBoost" Content="Optimizar RAM ahora" Click="BtnBoost_Click" HorizontalAlignment="Stretch" Background="#CBA6F7" Foreground="#11111B"/>
        </StackPanel>
        </Border>
        <Border Background="#2A2B3D" CornerRadius="12" Padding="14" Margin="0,0,0,12">
        <StackPanel>
        <TextBlock Text="Limpieza rapida" FontSize="17" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="TEMP, Windows Temp, Delivery Optimization, INetCache + flush DNS." Foreground="#D0D4E8" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
        <Button x:Name="BtnClean" Content="Limpiar temporales" Click="BtnClean_Click" HorizontalAlignment="Stretch" Background="#89B4FA" Foreground="#11111B"/>
        </StackPanel>
        </Border>
        <ProgressBar x:Name="Bar" Height="8" Margin="4,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#CBA6F7" Background="#313244" BorderThickness="0"/>
        <Border Background="#11111B" CornerRadius="12" Padding="10" Margin="0,10,0,0">
        <TextBox x:Name="TxtResult" Height="170" IsReadOnly="True" TextWrapping="Wrap"
                 Background="Transparent" Foreground="White" FontSize="12" BorderThickness="0" Padding="4"
                 VerticalScrollBarVisibility="Auto"/>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
