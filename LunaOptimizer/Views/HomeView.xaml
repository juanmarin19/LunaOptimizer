<UserControl x:Class="LunaOptimizer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Tarjeta con hover (estilo PC Manager) -->
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ===== Mejora de rendimiento ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x26A1;" FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Mejora de rendimiento" FontSize="15" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtRamTotal" Text="RAM" FontSize="11" Foreground="#4CC2FF"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Libera recursos para ayudar a tu PC a tener un rendimiento rapido."
                               FontSize="11.5" Foreground="#B9B9B9" Margin="0,5,0,0" TextWrapping="Wrap"/>

                    <!-- Dos indicadores -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatTile}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2" Background="#4CC2FF" VerticalAlignment="Stretch" Margin="0,1,8,1"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtMemPct" Text="—" FontSize="19" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Uso de memoria" FontSize="10.5" Foreground="#B9B9B9" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="5,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2" Background="#4CC2FF" VerticalAlignment="Stretch" Margin="0,1,8,1"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtTempVal" Text="..." FontSize="19" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Archivos temporales" FontSize="10.5" Foreground="#B9B9B9" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Button x:Name="BtnBoost" Style="{StaticResource PrimaryBtn}" Content="Mejorar el rendimiento"
                            Margin="4,12,4,0" HorizontalAlignment="Stretch" Click="BtnBoost_Click"/>
                    <ProgressBar x:Name="BarAct" Height="4" Margin="4,10,4,0" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="#4CC2FF" Background="#333333" BorderThickness="0"/>
                    <TextBlock x:Name="TxtHint" Text="" FontSize="11" Foreground="#B9B9B9"
                               Margin="4,8,4,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ===== 4 tarjetas ===== -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}" MouseLeftButtonUp="GoProcesos">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Proceso" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="&#x1F4CB;" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="En curso" FontSize="10.5" Foreground="#B9B9B9" Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtApps" Text="..." FontSize="15" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}" Margin="5,0,0,5" MouseLeftButtonUp="GoDeep">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Limpieza profunda" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="&#x1F9F9;" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="TxtDiskName" Text="Disco local (C:)" FontSize="10.5" Foreground="#B9B9B9" Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtDiskVal" Text="..." FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        <ProgressBar x:Name="BarDisk" Height="4" Margin="0,7,0,0" Maximum="100"
                                     Foreground="#4CC2FF" Background="#333333" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,5,5,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Memoria" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="&#x1F5A5;" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="RAM libre" FontSize="10.5" Foreground="#B9B9B9" Margin="0,7,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtMemFree" Text="..." FontSize="14" FontWeight="Bold" Foreground="#4CC2FF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTile}" Margin="5,5,0,0" MouseLeftButtonUp="GoLimpieza">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ultima limpieza" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="&#x23F3;" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Realizada" FontSize="10.5" Foreground="#B9B9B9" Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtLastClean" Text="Nunca" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Limpieza rapida ===== -->
            <Border Style="{StaticResource Card}" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Limpieza rapida" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Como un reinicio sin reiniciar: cierra tus aplicaciones, borra temporales/caches y libera RAM"
                                   FontSize="10.5" Foreground="#B9B9B9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnQuickClean" Content="Limpiar" Padding="14,8" Margin="0"
                            VerticalAlignment="Center" Background="#333333" Click="BtnQuickClean_Click"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
