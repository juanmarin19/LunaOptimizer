<UserControl x:Class="LunaOptimizer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="Transparent">

        <!-- ===== Banner de revisión (tarjeta superior de PC Manager) ===== -->
        <Border x:Name="HeroCard" Background="{DynamicResource B_Hero1}"
                BorderBrush="{DynamicResource B_HeroBorder}" BorderThickness="1" CornerRadius="8"
                Padding="14,13" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="GoProtect">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                        Background="{DynamicResource B_Card}" VerticalAlignment="Center">
                    <Path x:Name="HeroIcon" Data="{StaticResource I.Shield}" Width="19" Height="19" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource B_Accent}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeroTitle" Text="Revisa el estado de tu PC" FontSize="13.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource B_Text}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtHeroSub" Text="Temporales, memoria, disco, arranque y antivirus en una pasada."
                               FontSize="11" Foreground="{DynamicResource B_Sub}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Path Grid.Column="2" Data="{StaticResource I.ChevronRight}" Width="9" Height="9" Stretch="Uniform"
                      VerticalAlignment="Center" Stroke="{DynamicResource B_Sub}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
        </Border>

        <!-- ===== Mejora de rendimiento ===== -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource I.Rocket}" Width="15" Height="15" Stretch="Uniform"
                              VerticalAlignment="Center" Stroke="{DynamicResource B_Accent}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <TextBlock Text="Mejora de rendimiento" Style="{StaticResource H2}" Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnSmart" Style="{StaticResource LinkBtn}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Content="Smart Boost" Click="BtnSmart_Click"
                            ToolTip="Optimiza solo cuando la memoria o los temporales pasan del limite"/>
                </Grid>
                <TextBlock Text="Libera recursos para que tu PC vaya más rápido." Style="{StaticResource Body}"
                           Margin="0,4,0,0"/>

                <!-- Dos indicadores con barra vertical, como PC Manager -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="4" Height="34" VerticalAlignment="Top" Margin="0,4,9,0">
                            <Border Background="{DynamicResource B_Track}" CornerRadius="2"/>
                            <Border x:Name="BarMemPct" Background="{DynamicResource B_Accent}" CornerRadius="2"
                                    VerticalAlignment="Bottom" Height="20"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtMemPct" Text="—" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}"/>
                            <TextBlock Text="Uso de memoria" FontSize="10.5" Foreground="{DynamicResource B_Sub}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" Margin="6,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="4" Height="34" VerticalAlignment="Top" Margin="0,4,9,0">
                            <Border Background="{DynamicResource B_Track}" CornerRadius="2"/>
                            <Border x:Name="BarTemp" Background="{DynamicResource B_Accent}" CornerRadius="2"
                                    VerticalAlignment="Bottom" Height="8"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtTempVal" Text="—" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}"/>
                            <TextBlock Text="Temporales" FontSize="10.5" Foreground="{DynamicResource B_Sub}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Button x:Name="BtnBoost" Style="{StaticResource PrimaryBtn}" Content="Mejorar"
                        Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="BtnBoost_Click"/>
                <ProgressBar x:Name="BarAct" Height="3" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="Collapsed"/>
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="TxtHint" Text="" FontSize="10.5" Foreground="{DynamicResource B_Sub}"
                               TextWrapping="Wrap" Margin="0,0,64,0"/>
                    <Button x:Name="BtnCancel" Content="Cancelar" Style="{StaticResource LinkBtn}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                            Click="BtnCancel_Click"/>
                </Grid>
                <Border x:Name="PanelPesadas" Visibility="Collapsed" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource B_Border}" BorderThickness="1"
                        CornerRadius="6" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPesadas" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource B_Text}"/>
                            <TextBlock x:Name="TxtPesadasSub" Text="Cerrarlas al optimizar" FontSize="9.5"
                                       Foreground="{DynamicResource B_Sub}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkPesadas" Grid.Column="1" VerticalAlignment="Center"
                                  Margin="8,0,0,0" Click="ChkPesadas_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Cuatro tarjetas de estado ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,4,8"
                    MouseLeftButtonUp="GoProtect" MinHeight="84">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Revisión de salud" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
                        <Path Data="{StaticResource I.Scan}" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Stroke="{DynamicResource B_Sub}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock Text="Última revisión" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
                    <TextBlock x:Name="TxtRevision" Text="Nunca" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}" Margin="4,0,0,8"
                    MouseLeftButtonUp="GoProc" MinHeight="84">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Procesos" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>
                        <Path Data="{StaticResource I.List}" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Stroke="{DynamicResource B_Sub}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock Text="En curso" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
                    <TextBlock x:Name="TxtApps" Text="—" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,4,8"
                    MouseLeftButtonUp="GoDeep" MinHeight="84">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Limpieza profunda" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
                        <Path Data="{StaticResource I.Sparkle}" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Stroke="{DynamicResource B_Sub}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock x:Name="TxtDiskName" Text="Disco local" Style="{StaticResource Caption}"
                               Margin="0,9,0,0"/>
                    <TextBlock x:Name="TxtDiskVal" Text="—" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                    <ProgressBar x:Name="BarDisk" Height="3" Margin="0,6,0,0" Maximum="100"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" Margin="4,0,0,8"
                    MouseLeftButtonUp="GoStartup" MinHeight="84">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Arranque" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>
                        <Path Data="{StaticResource I.Power}" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Stroke="{DynamicResource B_Sub}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock Text="Tiempo de arranque" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
                    <TextBlock x:Name="TxtBoot" Text="—" Style="{StaticResource Value}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Limpieza rápida ===== -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Limpieza rápida" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource B_Text}"/>
                    <TextBlock x:Name="TxtLastClean" Text="Temporales, cachés y DNS. Como reiniciar sin reiniciar."
                               FontSize="10.5" Foreground="{DynamicResource B_Sub}" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnQuickClean" Content="Limpiar" Style="{StaticResource SecondaryBtn}"
                        VerticalAlignment="Center" Click="BtnQuickClean_Click"/>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
