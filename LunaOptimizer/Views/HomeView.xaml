<UserControl x:Class="LunaOptimizer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Tarjeta con hover (estilo PC Manager) -->
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_HoverTile}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ===== Mejora de rendimiento ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource I.Zap}" Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,7,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource B_Accent}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="Mejora de rendimiento" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtRamTotal" Text="RAM" FontSize="11"
                                   Foreground="{DynamicResource B_Accent}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Libera recursos para ayudar a tu PC a tener un rendimiento rapido."
                               FontSize="11.5" Foreground="{DynamicResource B_Sub}" Margin="0,5,0,0" TextWrapping="Wrap"/>

                    <!-- Dos indicadores -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatTile}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{DynamicResource B_Accent}"
                                        VerticalAlignment="Stretch" Margin="0,1,8,1"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtMemPct" Text="—" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource B_Text}"/>
                                    <TextBlock Text="Uso de memoria" FontSize="10.5" Foreground="{DynamicResource B_Sub}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="5,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{DynamicResource B_Accent}"
                                        VerticalAlignment="Stretch" Margin="0,1,8,1"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtTempVal" Text="..." FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource B_Text}"/>
                                    <TextBlock Text="Archivos temporales" FontSize="10.5" Foreground="{DynamicResource B_Sub}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Historial de uso de RAM (ultimos 60 s) -->
                    <Border x:Name="SparkBox" Height="44" Margin="4,12,4,0" CornerRadius="6"
                            Background="{DynamicResource B_Chip}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Uso de RAM - ultimos 60 s" FontSize="9.5"
                                       Foreground="{DynamicResource B_Sub}" Margin="8,5,0,0" VerticalAlignment="Top"/>
                            <Path x:Name="SparkRam" Stretch="Fill" Margin="8,17,8,7"
                                  Stroke="{DynamicResource B_Accent}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnBoost" Style="{StaticResource PrimaryBtn}" Content="Mejorar el rendimiento"
                            Margin="4,12,4,0" HorizontalAlignment="Stretch" Click="BtnBoost_Click"/>
                    <ProgressBar x:Name="BarAct" Height="4" Margin="4,10,4,0" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="{DynamicResource B_Accent}"
                                 Background="{DynamicResource B_Track}" BorderThickness="0"/>
                    <Button x:Name="BtnCancel" Content="Cancelar" Click="BtnCancel_Click" Visibility="Collapsed"
                            HorizontalAlignment="Left" Margin="4,8,4,0" Padding="12,5" FontSize="12"/>
                    <TextBlock x:Name="TxtHint" Text="" FontSize="11" Foreground="{DynamicResource B_Sub}"
                               Margin="4,8,4,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ===== 4 tarjetas ===== -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}" MouseLeftButtonUp="GoProcesos">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Proceso" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource I.List}" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stroke="{DynamicResource B_Sub}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock Text="En curso" FontSize="10.5" Foreground="{DynamicResource B_Sub}" Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtApps" Text="..." FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource B_Accent}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}" Margin="5,0,0,5" MouseLeftButtonUp="GoDeep">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Limpieza profunda" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Path Data="{StaticResource I.Sparkle}" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stroke="{DynamicResource B_Sub}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="TxtDiskName" Text="Disco local (C:)" FontSize="10.5"
                                   Foreground="{DynamicResource B_Sub}" Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtDiskVal" Text="..." FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource B_Text}" Margin="0,2,0,0"/>
                        <ProgressBar x:Name="BarDisk" Height="4" Margin="0,7,0,0" Maximum="100"
                                     Foreground="{DynamicResource B_Accent}" Background="{DynamicResource B_Track}"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,5,5,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Memoria" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource I.Monitor}" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stroke="{DynamicResource B_Sub}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock Text="RAM libre" FontSize="10.5" Foreground="{DynamicResource B_Sub}" Margin="0,7,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtMemFree" Text="..." FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource B_Accent}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTile}" Margin="5,5,0,0" MouseLeftButtonUp="GoLimpieza">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ultima limpieza" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Path Data="{StaticResource I.Clock}" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stroke="{DynamicResource B_Sub}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock Text="Realizada" FontSize="10.5" Foreground="{DynamicResource B_Sub}" Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtLastClean" Text="Nunca" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource B_Text}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Limpieza rapida ===== -->
            <Border Style="{StaticResource Card}" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Limpieza rapida" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B_Text}"/>
                        <TextBlock Text="Como un reinicio sin reiniciar: cierra tus aplicaciones, borra temporales/caches y libera RAM"
                                   FontSize="10.5" Foreground="{DynamicResource B_Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnQuickClean" Content="Limpiar" Padding="14,8" Margin="0"
                            VerticalAlignment="Center" Background="{DynamicResource B_Button}" Click="BtnQuickClean_Click"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
