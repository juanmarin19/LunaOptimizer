<Window x:Class="LunaOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaOptimizer"
        Icon="LunaOptimizer.ico"
        Width="456" Height="664"
        MinWidth="456" MinHeight="664" MaxWidth="456" MaxHeight="664"
        ResizeMode="CanMinimize" WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B_Window}" Foreground="{DynamicResource B_Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: la banda superior no captura el raton; el arrastre lo
             hace el Border con MouseLeftButtonDown, y los botones reciben su clic. -->
        <WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" NonClientFrameEdges="None"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Item del rail: icono + etiqueta, con barra azul a la izquierda cuando
             esta activo (igual que Microsoft PC Manager). -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource B_Sub}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Pill" CornerRadius="8" Margin="7,3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="{DynamicResource B_Accent}"
                                    Visibility="Collapsed"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,0,0">
                                <Path x:Name="Ico" Data="{TemplateBinding Tag}" Stretch="Uniform"
                                      Width="19" Height="19" HorizontalAlignment="Center"
                                      Stroke="{DynamicResource B_Sub}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="9.5" HorizontalAlignment="Center"
                                           Margin="0,4,0,0" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource B_Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
                                <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource B_Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource B_Hover2}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_Link}"/>
                                <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource B_Link}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton de la barra de titulo -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Sub}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B_Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource B_Border}" BorderThickness="1"
            Background="{DynamicResource B_Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Barra de titulo ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <Image Source="LunaOptimizer.ico" Width="18" Height="18" Margin="0,0,7,0" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="LunaOptimizer" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B_Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtn}" Click="BtnTheme_Click"
                            AutomationProperties.Name="Cambiar tema claro u oscuro" ToolTip="Tema claro/oscuro">
                        <Path x:Name="ThemeIcon" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource B_Sub}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="{StaticResource I.Moon}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="BtnMin_Click" ToolTip="Minimizar"
                            AutomationProperties.Name="Minimizar">
                        <Path Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource B_Sub}"
                              StrokeThickness="1.3" Data="M2,6 H14"/>
                    </Button>
                    <Button Style="{StaticResource CloseBtn}" Click="BtnClose_Click" ToolTip="Cerrar"
                            AutomationProperties.Name="Cerrar">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource B_Sub}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M2,2 L12,12 M12,2 L2,12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Rail + contenido ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource B_Rail}"
                        BorderBrush="{DynamicResource B_RailBorder}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <RadioButton x:Name="NavHome" DockPanel.Dock="Top" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.Home}" Content="Inicio" IsChecked="True"
                                     Checked="NavHome_Checked"/>
                        <RadioButton x:Name="NavProtect" DockPanel.Dock="Top" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.Shield}" Content="Protección" Checked="NavProtect_Checked"/>
                        <RadioButton x:Name="NavStorage" DockPanel.Dock="Top" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.Pie}" Content="Almacén" Checked="NavStorage_Checked"/>
                        <RadioButton x:Name="NavProc" DockPanel.Dock="Top" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.List}" Content="Procesos" Checked="NavProc_Checked"/>
                        <RadioButton x:Name="NavClean" DockPanel.Dock="Top" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.Sparkle}" Content="Limpieza" Checked="NavClean_Checked"/>
                        <RadioButton x:Name="NavApps" DockPanel.Dock="Top" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.Grid}" Content="Aplicaciónes" Checked="NavApps_Checked"/>
                        <RadioButton x:Name="NavTools" DockPanel.Dock="Top" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.Toolbox}" Content="Herramientas" Checked="NavTools_Checked"/>

                        <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavBtn}"
                                     Tag="{StaticResource I.Gear}" Content="Ajustes" Checked="NavSettings_Checked"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Background=Transparent: sin fondo el ScrollViewer no recibe la
                         rueda del raton en las zonas vacias de la tarjeta. -->
                    <ScrollViewer x:Name="Scroller" Grid.Row="0" Background="Transparent"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Padding="0">
                        <ContentControl x:Name="Host" Margin="12,10,12,4" Focusable="False"/>
                    </ScrollViewer>

                    <Border Grid.Row="1" Padding="14,4,14,7" Background="Transparent">
                        <Grid>
                            <TextBlock x:Name="TxtStatus" Text="Listo." FontSize="10.5"
                                       Foreground="{DynamicResource B_Muted}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtVersion" Text="" FontSize="10"
                                       Foreground="{DynamicResource B_Muted}" Opacity="0.85"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
