<Window x:Class="LunaOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaOptimizer"
        Icon="LunaOptimizer.ico"
        Width="456" Height="664"
        MinWidth="456" MinHeight="664" MaxWidth="456" MaxHeight="664"
        ResizeMode="CanMinimize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="#1A1A1A" Foreground="White">
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: si es 32 toda la banda superior es HTCAPTION y
             los botones de minimizar/cerrar reciben el drag en vez del click -->
        <WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" NonClientFrameEdges="None"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Item de navegacion lateral estilo PC Manager: icono + etiqueta -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B9B9B9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,8">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="17" HorizontalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="9" HorizontalAlignment="Center"
                                           Margin="0,3,0,0" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F1F1F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262626"/>
                                <Setter Property="Foreground" Value="#4CC2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Boton de barra de titulo -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9B9B9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#333333" BorderThickness="1" Background="#1A1A1A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de titulo propia: client total = 456x664 como PC Manager -->
            <Grid Grid.Row="0" Background="#0F0F0F">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Image Source="LunaOptimizer.ico" Width="32" Height="32" Margin="0,0,8,0" Stretch="Uniform"/>
                        <TextBlock Text="LunaOptimizer" FontSize="11" Foreground="#B9B9B9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtn}" Content="&#x2500;" Click="BtnMin_Click" ToolTip="Minimizar"/>
                    <Button Style="{StaticResource CloseBtn}" Content="&#x2715;" Click="BtnClose_Click" ToolTip="Cerrar"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rail lateral -->
                <Border Grid.Column="0" Background="#0F0F0F">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Margin="0,12,0,10">
                            <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center" Background="#0F0F0F">
                                <Image Source="LunaOptimizer.ico" Width="56" Height="56" Stretch="Uniform"/>
                            </Border>
                        </Border>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavBtn}" Tag="&#x1F3E0;" Content="Inicio"
                                     DockPanel.Dock="Top" IsChecked="True" Checked="NavHome_Checked"/>
                        <RadioButton x:Name="NavProc" Style="{StaticResource NavBtn}" Tag="&#x1F4CB;" Content="Procesos"
                                     DockPanel.Dock="Top" Checked="NavProc_Checked"/>
                        <RadioButton x:Name="NavClean" Style="{StaticResource NavBtn}" Tag="&#x1F9F9;" Content="Limpieza"
                                     DockPanel.Dock="Top" Checked="NavClean_Checked"/>
                    </DockPanel>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,12,12,8">
                        <TextBlock x:Name="TxtTitle" Text="Inicio" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtSub" Text="RAM: ..." FontSize="11" Foreground="#B9B9B9" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ContentControl x:Name="Host" Grid.Row="1" Margin="12,0,12,0" Focusable="False"/>

                    <Border Grid.Row="2" Background="#0F0F0F" Padding="12,7" Margin="12,6,12,10" CornerRadius="8">
                        <TextBlock x:Name="TxtStatus" Text="Listo." FontSize="11" Foreground="#B9B9B9"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
